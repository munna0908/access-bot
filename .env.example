# Server configuration
PORT=8080
HOST=localhost

# LLM Provider selection: "claude", "gemini", "mock", or "auto" (default)
# "auto" will use Claude if ANTHROPIC_API_KEY is set, otherwise Gemini, otherwise Mock
LLM_PROVIDER=auto

# Claude API configuration (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# Gemini API configuration (https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy-xxxxx
GEMINI_MODEL=gemini-2.0-flash

# Session Provider: "intelligence", "mock", or "auto" (default)
# "auto" will use intelligence service if INTELLIGENCE_SERVICE_URL is set, otherwise Mock
SESSION_PROVIDER=auto

# Participant Intelligence Service configuration
INTELLIGENCE_SERVICE_URL=http://localhost:3000

# Filesystem Provider: "pinata", "mock", or "auto" (default)
FILESYSTEM_PROVIDER=auto

# Pinata IPFS configuration (https://pinata.cloud)
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
PINATA_GATEWAY_KEY=
PINATA_JWT=
PINATA_PRIVATE=false

# Timeouts (in seconds)
HTTP_CLIENT_TIMEOUT=30
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=30

# Logging
LOG_LEVEL=info
